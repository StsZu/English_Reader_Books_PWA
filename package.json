{
  "name": "english-reader-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pl": "APP_LANG=pl vite",
    "build": "npm run typecheck && vite build",
    "build:pl": "npm run typecheck && APP_LANG=pl vite build",
    "preview": "vite preview",
    "preview:pl": "APP_LANG=pl vite preview",
    "test": "vitest run && APP_LANG=pl vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test && APP_LANG=pl playwright test",
    "test:live": "LIVE=1 vitest run tests/languages",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.pl.json",
    "golden": "GOLDEN=1 vitest run tests/golden",
    "reader-tool": "node scripts/build-reader-tool.mjs",
    "prepared-book": "esbuild scripts/make-reader-book.ts --bundle --platform=node --format=esm --outfile=build/make-reader-book.mjs --log-level=warning --define:__TEST_MODE__=false --alias:#language=./src/languages/${APP_LANG:-en}.ts && node build/make-reader-book.mjs",
    "size": "node scripts/size.mjs",
    "check": "npm run build && node scripts/check-language.mjs && sh scripts/check-secrets.sh && node scripts/size.mjs && npm run build:pl && APP_LANG=pl node scripts/check-language.mjs && sh scripts/check-secrets.sh && node scripts/size.mjs"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "idb": "8.0.4",
    "lucide-preact": "1.52.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@playwright/test": "1.58.2",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
