{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "#language": ["./src/languages/en.ts"],
      "#test-language": ["./tests/languages/en/fixtures.ts"]
    }
  },
  "include": ["src", "tests", "scripts", "languages", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"],
  "exclude": ["src/languages/pl.ts", "tests/languages/pl"]
}
