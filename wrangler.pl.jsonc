// Cloudflare Workers, Polish Reader (specs/014-shared-core, S5): static site from `dist/` built by `npm run build:pl`
// (CSP and headers in `public/_headers`). Deploy: `npx wrangler deploy --config wrangler.pl.jsonc`;
// branches: `npx wrangler preview --config wrangler.pl.jsonc`.
{
  "name": "polish-reader-books-pwa",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./dist",
    // As the configuration that Cloudflare's autoconfig made for the sites before the merge: unknown paths get index.html.
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "previews": {}
}
